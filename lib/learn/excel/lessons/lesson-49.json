  "tasks": [
    {
      "prompt": "Build a pivot table of total gross by genre. Click any cell inside the data, open the **Insert** tab at the top of the toolbar, and click **Pivot table**. The Insights panel opens on the right. Set **Rows** to Genre, **Values** to Gross ($M), and **Summarize by** to Sum.",
      "teach": "A pivot table has 3 main choices:\n- **Rows:** the field whose values go down the side (one row per genre).\n- **Values:** the number to summarise.\n- **Summarize by:** how to combine the numbers: Sum, Count, Average, Max or Min.",
      "pivot": {
        "rows": "Genre",
        "values": "Gross ($M)",
        "agg": "sum"
      },
      "hints": [
        "Open the panel from Insert → Pivot table, then use the 3 dropdowns.",
        "Rows: Genre. Values: Gross ($M). Summarize by: Sum."

  "tasks": [
    {
      "prompt": "Make a column chart of total gross by genre. Click any cell inside the data, open the **Insert** tab, and click **Chart**. (If the panel is already open, just click its **Chart** tab.) Set Chart type to Column, X field to Genre, Y field to Gross ($M), and Summarize by to Sum.",
      "teach": "On a chart, the **X field** gives the categories along the bottom, and the **Y field** gives the bar heights. **Summarize by** combines rows that share the same X value, like a pivot table does.",
      "chart": {
        "type": "column",
        "x": "Genre",
        "y": "Gross ($M)",
        "agg": "sum"
      },
      "hints": [
        "Insert → Chart, then the dropdowns.",
        "Type: Column, X: Genre, Y: Gross ($M), Sum."
      ],
      "answer": "Column chart, X: Genre, Y: Gross ($M), Sum"
    },
    {
      "prompt": "Which genre has the tallest column? Type it into J2.",
      "cell": "J2",
      "expected": "Action",
      "hints": [
        "Find the tallest bar.",
        "Action, at 605."
      ],
      "highlight": [
        "J2"
      ],
      "answer": "Action"
    },
    {
      "prompt": "Give the chart a title: type Gross by genre into the Title box.",
      "teach": "Every chart needs a **title** that says what it shows. A chart without one gets misread.",
      "chart": {
        "type": "column",
        "x": "Genre",
        "y": "Gross ($M)",
        "title": "Gross by genre"
      },
      "hints": [
        "Type in the Title box exactly: Gross by genre",
        "Capital G only."
      ],
      "answer": "Title: Gross by genre"
    },
    {
      "prompt": "Long labels squash a column chart. Change it to a Bar chart of each movie's gross: Type Bar, X field Movie, Y field Gross ($M).",
      "teach": "**Bar charts** turn the bars sideways, so long labels like movie titles have room to be read. Use them when you have many categories or long names.",
      "chart": {
        "type": "bar",
        "x": "Movie",
        "y": "Gross ($M)"
      },
      "hints": [
        "Change Chart type to Bar and X field to Movie.",
        "Type: Bar, X: Movie, Y: Gross ($M)."
      ],
      "answer": "Bar chart, X: Movie, Y: Gross ($M)"
    },
    {
      "prompt": "Last one: which single movie made the most? Type its name into J3.",
      "cell": "J3",

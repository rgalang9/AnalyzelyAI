      "shortcut": "jump_down",
      "shortcut_help": "badge",
      "shortcut_required": true,
      "hints": [
        "Click A1 first, then hold Ctrl (⌘ on Mac) and press the down arrow.",
        "You should land on A31, the last book."
      ]
    },
    {
      "prompt": "Now jump back up to A1.",
      "selected": "A1",
      "shortcut": "jump_up",
      "shortcut_help": "hint",
      "shortcut_required": true,
      "hints": [
        "It's the same idea, with the up arrow.",
        "Hold Ctrl (⌘ on Mac) and press the up arrow."
      ]
    },
    {
      "prompt": "From A1, jump right to the last column of the table, D1 (Fine).",
      "selected": "D1",
      "shortcut": "jump_right",
      "shortcut_help": "badge",
      "shortcut_required": true,
      "hints": [
        "Hold Ctrl (⌘ on Mac) and press the right arrow.",
        "It stops at D1, because E1 is empty."
      ]
    },
    {
      "prompt": "Click D2, then select all the fines down to D31 in one go.",
      "teach": "Add **Shift** to a jump and it **selects** everything along the way. Ctrl+Shift+↓ (⌘+Shift+↓ on Mac) selects from where you are down to the bottom of the data.",
      "selected": "D2:D31",
      "shortcut": "select_down",
      "shortcut_help": "badge",
      "shortcut_required": true,
      "hints": [
        "Click D2 first, then add Shift to the jump-down keys.",
        "Hold Ctrl+Shift (⌘+Shift on Mac) and press the down arrow."
      ]
    },
    {

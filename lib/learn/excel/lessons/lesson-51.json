  "tasks": [
    {
      "prompt": "Build a pivot of total gross by genre. Click any cell inside the data, open the **Insert** tab at the top of the toolbar, and click **Pivot table**. The Insights panel opens on the right. Rows: Genre, Values: Gross ($M), Summarize by: Sum.",
      "pivot": {
        "rows": "Genre",
        "values": "Gross ($M)",
        "agg": "sum"
      },
      "hints": [
        "Insert → Pivot table, then the 3 dropdowns.",
        "Rows: Genre, Values: Gross ($M), Sum."
      ],
      "answer": "Rows: Genre, Values: Gross ($M), Sum"
    },
    {
      "prompt": "Add a slicer for Rating, and show only PG-13 movies: choose Rating from **Add a slicer…**, then untick PG and R.",
      "teach": "A **slicer** shows a tick box for every value of a field. Everything starts ticked. Untick the values you want to leave out, and the pivot updates instantly.",
      "pivot": {
        "rows": "Genre",
        "values": "Gross ($M)",
        "agg": "sum",
        "slicers": {
          "Rating": [
            "PG-13"
          ]
        }
      },
      "hints": [
        "Use the Add a slicer… dropdown and pick Rating.",
        "Untick PG and R, so only PG-13 stays ticked."
      ],
      "answer": "Slicer on Rating with only PG-13 ticked"
    },
    {
      "prompt": "Among PG-13 movies, which genre made the most? Type it into J2.",
      "cell": "J2",
      "expected": "Action",
      "hints": [
        "Read the biggest number in the filtered pivot.",
        "Action again, with 605."
      ],
      "highlight": [
        "J2"
      ],
      "answer": "Action"
    },
    {
      "prompt": "What's the total gross of PG-13 Action movies? Type the number into J3.",
      "cell": "J3",
      "expected": 605,
      "hints": [
        "It's Action's number in the filtered pivot.",
        "605"
      ],
      "highlight": [
        "J3"
      ],
      "answer": "605"
    },
    {
      "prompt": "Remove the Rating slicer. Then change Rows to Month, and add a Genre slicer showing only Horror and Comedy.",
      "pivot": {
        "rows": "Month",
        "values": "Gross ($M)",
        "agg": "sum",
        "slicers": {
          "Genre": [
            "Horror",
            "Comedy"
          ]
        }
      },
      "hints": [
        "Click Remove on the Rating slicer, change Rows to Month, then add a slicer for Genre.",
        "In the Genre slicer, keep only Horror and Comedy ticked."
      ],
      "answer": "Rows: Month, Gross Sum, slicer on Genre with only Horror and Comedy"
    },
    {
      "prompt": "Last one: which month was best for Horror and Comedy together? Type its 3-letter name into J4.",
      "cell": "J4",
      "expected": "Jun",
      "hints": [
        "Read the biggest monthly total.",
        "June: Beach Week (88) + The Attic (66)."
      ],
      "highlight": [
        "J4"
      ],
      "answer": "Jun"

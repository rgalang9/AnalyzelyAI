        "line": ".assign(with_tip=lambda d: d[\"total\"] + d[\"tip\"])",
        "explain": "Step 2: add a with_tip column."
      },
      {
        "line": ".sort_values(\"with_tip\", ascending=False)",
        "explain": "Step 3: biggest first."
      },
      {
        "line": ".head(3)",
        "explain": "Step 4: the top 3. The round brackets let the chain span several lines."
      }
    ]
